{
  "manifest_version": 3,
  "name": "FondaFinder PA",
  "version": "1.0",
  "description": "Find affordable comida de calle in Panama",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
